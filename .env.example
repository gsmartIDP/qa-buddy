# Optional fine-grained GitHub personal access token for private HTTPS repositories.
# Select only the repositories QA Buddy needs and grant Contents: read-only.
# After changing any value in this file, recreate the worker with:
# docker compose up -d --force-recreate worker
GITHUB_TOKEN=

# Variables listed here are available to the worker. A repository runner only
# receives variables explicitly named in that repository's allowlist.
# 
# NPM_TOKEN=
# GITHUB_IDP_REGISTRY=

# Logins to use cypress
CYPRESS_CLERK_SECRET_KEY=sk_test_...
CYPRESS_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_AUTH_API_HOST=https://rpm-api.1.dev-idplans.com
VITE_AUTH_API_V2_HOST=https://api.1.dev-idplans.com
CYPRESS_username=
CYPRESS_password=
CYPRESS_adminEmail=
CYPRESS_adminPassword=
CYPRESS_designerEmail=
CYPRESS_designerPassword=
CYPRESS_vendorEmail=
CYPRESS_vendorPassword=
CYPRESS_cloudBaseUrl=http://localhost:5177
CYPRESS_idInspectBaseUrl=http://localhost:5172
CYPRESS_apiStaging=http://localhost:4900
CYPRESS_apiServiceStaging=http://localhost:3000

# Optional operational overrides.
RUN_HISTORY_LIMIT=20
QA_BUDDY_DATA_DIR=/data
QA_BUDDY_WORKSPACE_DIR=/workspaces
QA_BUDDY_WORKSPACE_VOLUME=qa-buddy-workspaces
# Directory holding your local checkouts, for local working tree runs
QA_BUDDY_LOCAL_SOURCE_ROOT=
# Run Cypress tests you need this one
COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack enable && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm install --frozen-lockfile
